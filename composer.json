{
  "name": "werkbot/werkbot-seeder",
  "description": "Development database seeder",
  "type": "silverstripe-vendormodule",
  "license": "MIT",
  "homepage": "https://github.com/werkbot/silverstripe-module-seeder",
  "require": {
   "php": "^8.3",
   "silverstripe/cms": "^6",
   "silverstripe/framework": "^6"
  },
  "require-dev": {
    "code-lts/doctum": "^5.5",
    "wernerkrauss/silverstripe-rector": "^1"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0.x-dev"
    }
  },
  "autoload": {
   "psr-4": {
     "Werkbot\\Seeder\\": "src/"
   }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
